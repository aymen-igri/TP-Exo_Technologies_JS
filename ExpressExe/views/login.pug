doctype html
html.bg-black
  head
    link(rel="stylesheet", href="/output.css")

  body.flex.flex-col.items-center.justify-center.mt-75
    form(action="/api/login", method="POST").bg-purple-900.border-2.border-purple-300.rounded-lg.p-3.flex.flex-col.items-center.justity-center
        h1.text-3xl.text-white.font-bold Login
        div.flex.flex-col.mt-2
            label(for="username").text-white.bald-md Username
            input(type="username", placeholder="xyz@domain.com", name="username", required).bg-gray-300.border-2.border-purple-300.rounded-md.w-md
        div.flex.flex-col.mt-2
            label(for="password").text-white.bald-md Password
            input(type="password", placeholder="••••••••", name="password", required).bg-gray-300.border-2.border-purple-300.rounded-md.w-md
        button(type="submit").bg-purple-500.text-white.px-4.py-2.rounded.mb-2.mt-2 Login
        a(href="/register").text-white.Underline i don't have an account yet.
